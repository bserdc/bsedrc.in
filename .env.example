# ---------------------------------------------------------------------------
# Admin authentication
# ---------------------------------------------------------------------------

# Numeric PIN gate for admin panel access (4-8 digits, e.g. 123456)
ADMIN_SECURITY_PIN=

# Username for the super-admin account (plain string, e.g. superadmin)
ADMIN_SUPER_USERNAME=

# Password for the super-admin account (use a strong password, min 12 chars)
ADMIN_SUPER_PASSWORD=

# ---------------------------------------------------------------------------
# Cloudflare R2 (S3-compatible object storage)
# ---------------------------------------------------------------------------

# R2 account ID (32-char hex string from Cloudflare dashboard)
CLOUDFLARE_R2_ACCOUNT_ID=

# R2 API token access key ID (from R2 -> Manage API Tokens)
CLOUDFLARE_R2_ACCESS_KEY_ID=

# R2 API token secret access key (shown once when creating the token)
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# Name of the R2 bucket to store uploads in (e.g. my-bucket)
CLOUDFLARE_R2_BUCKET_NAME=

# Public base URL for serving bucket objects (e.g. https://cdn.example.com)
# No trailing slash.
CLOUDFLARE_R2_PUBLIC_URL=

# ---------------------------------------------------------------------------
# App configuration
# ---------------------------------------------------------------------------

# Comma-separated list of allowed origins (e.g. http://localhost:3000,https://example.com)
# Use * to allow all origins (not recommended for production).
CORS_ORIGIN=

# Whether the app runs without external services (true | false, default: false)
OFFLINE_MODE=

# ---------------------------------------------------------------------------
# Firebase (client SDK / auth)
# ---------------------------------------------------------------------------

# Firebase Web API key (from Project Settings -> General)
FIREBASE_API_KEY=

# Firebase service account: either the raw JSON object (single line, quoted)
# or the JSON file contents base64-encoded.
FIREBASE_SERVICE_ACCOUNT_KEY=

# ---------------------------------------------------------------------------
# Auth / AI
# ---------------------------------------------------------------------------

# Secret used to sign JWTs. Use at least 32 random characters
# (e.g. generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=

# Google Gemini API key (from Google AI Studio)
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Razorpay (payments)
# ---------------------------------------------------------------------------

# Currency code for Razorpay transactions (e.g. INR, USD)
RAZORPAY_CURRENCY=

# Razorpay Key ID (e.g. rzp_test_xxxxxxxx or rzp_live_xxxxxxxx)
RAZORPAY_KEY_ID=

# Razorpay Key Secret (from Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_SECRET=