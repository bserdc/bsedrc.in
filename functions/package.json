{
  "name": "bsedrc-functions",
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=lib/index.js --external:firebase-functions",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-functions": "^6.3.2",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "~5.8.2"
  },
  "private": true
}
